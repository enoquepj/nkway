# ---------------------------------------------------------------
# NKWAY — variáveis de ambiente
# Copie este arquivo para ".env" e preencha com suas chaves.
# Sem estas variáveis o sistema roda em MODO DEMO (localStorage).
# ---------------------------------------------------------------

# Supabase → Project Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Gateway de pagamento (frontend usa apenas a chave pública)
VITE_STRIPE_PUBLIC_KEY=

# ---------------------------------------------------------------
# Bridge NF-e / SEFAZ (servidor SEU, com certificado A1)
# Sem esta URL a aba "Chave SEFAZ" roda em MODO DEMO (XML simulado).
# Com a URL, o front chama: POST {URL}/nfe/por-chave  body: { "chave": "44 dígitos" }
# Resposta esperada: { "xml": "<nfeProc>...</nfeProc>" }  ou  { "erro": "mensagem" }
# NUNCA coloque a senha do certificado .pfx no front — só no servidor do bridge.
# ---------------------------------------------------------------
VITE_NFE_BRIDGE_URL=

# ATENÇÃO: chaves secretas (service_role, Stripe secret, senha A1) NUNCA
# devem ficar aqui. Elas vivem apenas no servidor.

# --- DF-e (Supabase) — roteiro completo: supabase/DFE_ROTEIRO_CONFIG.md ---
# VITE_SUPABASE_URL=https://xxxx.supabase.co
# VITE_SUPABASE_ANON_KEY=
# Secrets só no Supabase Edge / worker (NÃO no Vite, NÃO no GitHub):
#   DFE_CRON_SECRET, DFE_SECRET, DFE_SEFAZ_MODE=demo|live
#   DFE_MTLS_WORKER_URL, DFE_MTLS_WORKER_SECRET
# Opcional (front antigo por chave pontual):
# VITE_NFE_BRIDGE_URL=
